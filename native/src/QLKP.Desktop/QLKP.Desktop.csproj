<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>QLKP.Desktop</AssemblyName>
    <RootNamespace>QLKP.Desktop</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.20.5.0</Version>
    <FileVersion>0.20.5.0</FileVersion>
    <Product>Quản lý Khu phố</Product>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>Assets\qlkp.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\qlkp.ico" />
    <Resource Include="Assets\qlkp-icon.png" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <PackageReference Include="System.Data.SQLite" Version="2.0.4" />
    <PackageReference Include="SQLite3MC.PCLRaw.lib" Version="2.6.1" GeneratePathProperty="true" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <Content Include="THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\database\schema.sql" Link="schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyQlkpNativeSqliteX64" AfterTargets="Build">
    <ItemGroup><QlkpMcRuntime Include="$(PkgSQLite3MC_PCLRaw_lib)\runtimes\win-x64\native\*sqlite*.dll" /></ItemGroup>
    <Error Condition="'@(QlkpMcRuntime->Count())' != '1'" Text="Expected one pinned SQLite3MC x64 native runtime." />
    <Copy SourceFiles="@(QlkpMcRuntime)" DestinationFiles="@(QlkpMcRuntime->'$(TargetDir)e_sqlite3.dll')" SkipUnchangedFiles="true" />
  </Target>
</Project>
