<UserControl x:Class="QLKP.Desktop.Views.AccessControlView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="White">
 <DockPanel Margin="14">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="I02 · VAI TRÒ, PHẠM VI VÀ QUYỀN TÀI KHOẢN" FontSize="23" FontWeight="Bold" Foreground="#102D59"/>
   <TextBlock Text="Tài khoản có sẵn quyền nghiệp vụ. Chỉ đặt giới hạn riêng khi cần. Tài khoản quản trị được bảo vệ khỏi khóa hoặc thay thế." TextWrapping="Wrap" Foreground="#526781"/>
   <WrapPanel Margin="0,10"><Button Content="Tải danh sách tài khoản" Click="Reload_Click"/><TextBlock x:Name="Info" Foreground="#A44312" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel>
  </StackPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
   <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" x:Name="Accounts" Grid.Column="0" SelectionChanged="Accounts_SelectionChanged">
    <DataGrid.Columns><DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="*"/><DataGridTextColumn Header="Vai trò" Binding="{Binding RoleDisplay}" Width="130"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="105"/></DataGrid.Columns>
   </DataGrid>
   <Border Grid.Column="1" BorderBrush="#D7E4F1" BorderThickness="1" Margin="12,0,0,0" Padding="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="PHÂN QUYỀN CHI TIẾT" FontSize="17" FontWeight="Bold" Foreground="#102D59"/>
     <TextBlock x:Name="SelectedAccount" Text="Chưa chọn tài khoản" TextWrapping="Wrap"/>
     <CheckBox x:Name="RightB01Read" Margin="8" Content="B01 · Xem Hộ gia đình"/>
     <CheckBox x:Name="RightB01Create" Margin="8" Content="B01 · Thêm Hộ gia đình"/>
     <CheckBox x:Name="RightB02Read" Margin="8" Content="B02 · Xem Nhân khẩu"/>
     <CheckBox x:Name="RightB02Create" Margin="8" Content="B02 · Thêm Nhân khẩu"/>
     <CheckBox x:Name="RightB02Update" Margin="8" Content="B02 · Cập nhật hồ sơ theo ID"/><CheckBox x:Name="RightB03Read" Margin="8" Content="B03 · Xem biến động"/>
     <CheckBox x:Name="RightB03Create" Margin="8" Content="B03 · Chuyển hộ trong địa bàn"/>
     <CheckBox x:Name="RightI08Read" Margin="8" Content="I08 · Kiểm tra chất lượng dữ liệu (chỉ đọc)"/>
     <TextBlock Text="Các quyền nghiệp vụ bổ sung" FontWeight="Bold" Margin="0,10,0,0"/>
     <StackPanel x:Name="AdditionalRights"/>
     <TextBlock Text="Lưu quyền sẽ cập nhật phiên bản chính sách và khiến phiên cũ không còn hợp lệ." TextWrapping="Wrap" Foreground="#526781"/>
     <Button x:Name="SaveRights" Content="Lưu thay đổi quyền" Click="Save_Click"/>
     <Button x:Name="BlockAccount" Content="Khóa tài khoản được chọn" Click="Block_Click"/>
     <Button x:Name="UnblockAccount" Content="Mở khóa tài khoản được chọn" Click="Unblock_Click"/>
     <TextBlock Text="Không cho phép tự cấp quyền, sửa ADMIN gốc, hoặc sửa tài khoản khác địa bàn." TextWrapping="Wrap" Foreground="#A44312"/>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
 </DockPanel>
</UserControl>