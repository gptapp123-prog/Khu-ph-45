<UserControl x:Class="QLKP.Desktop.Views.LocalQrIntakeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F8FBFF">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="18">
   <TextBlock Text="I05 · Mã QR hồ sơ" FontSize="23" FontWeight="Bold" Foreground="#102D59"/>
   <TextBlock Text="Mở hồ sơ" FontWeight="Bold" Margin="0,14,0,4"/>
   <WrapPanel>
    <Button x:Name="OpenQrImage" Content="Mở ảnh QR" Click="OpenImage_Click" Padding="12,6"/>
    <Button x:Name="OpenQrFile" Content="Mở mã từ TXT" Click="OpenTextFile_Click" Padding="12,6"/>
    <TextBox x:Name="QrPayload" Width="260" MaxLength="128" ToolTip="Dán nội dung QR nội bộ đã quét"/>
    <Button x:Name="OpenQrText" Content="Mở mã đã dán" Click="Qr_Click" Padding="12,6"/>
   </WrapPanel>
   <TextBlock Text="Tạo mã QR" FontWeight="Bold" Margin="0,14,0,4"/>
   <WrapPanel>
    <ComboBox x:Name="TargetType" Width="125" SelectionChanged="SearchInput_Changed"/>
    <TextBox x:Name="Keyword" Width="240" MaxLength="100" TextChanged="SearchInput_Changed" ToolTip="Mã hộ hoặc họ tên"/>
    <Button x:Name="SearchTargets" Content="Tìm hồ sơ" Click="Search_Click" Padding="12,6"/>
    <Button x:Name="PreviousTargets" Content="Trước" IsEnabled="False" Click="Previous_Click"/>
    <Button x:Name="NextTargets" Content="Sau" IsEnabled="False" Click="Next_Click"/>
   </WrapPanel>
   <ListBox x:Name="Targets" Height="120" DisplayMemberPath="Label" SelectionChanged="Target_Changed" Margin="0,6,0,0"/>
   <WrapPanel Margin="0,5,0,0">
    <Button x:Name="CreateQr" Content="Tạo QR" IsEnabled="False" Click="Create_Click" Padding="12,6"/>
    <Button x:Name="SaveQr" Content="Lưu ảnh PNG" IsEnabled="False" Click="Save_Click" Padding="12,6"/>
   </WrapPanel>
   <TextBlock x:Name="ResultMessage" TextWrapping="Wrap" Margin="0,8,0,0"/>
   <Image x:Name="PreviewQr" Width="220" Height="220" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
