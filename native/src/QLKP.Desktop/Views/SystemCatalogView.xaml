<UserControl x:Class="QLKP.Desktop.Views.SystemCatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F8FBFF">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,12">
   <CheckBox x:Name="GlobalScope" Content="Chỉnh sửa danh mục chung toàn ứng dụng" Checked="Scope_Changed" Unchecked="Scope_Changed" Margin="4,8"/>
<TextBlock Text="I07 · Danh mục dùng chung" FontSize="23" FontWeight="Bold" Foreground="#102D59"/><TextBlock Text="Danh mục có phạm vi riêng khu phố hoặc toàn hệ thống. Không xóa mã đã sử dụng." Foreground="#526B88"/></StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,8"><Button x:Name="LoadStandard" DockPanel.Dock="Right" Content="Nạp danh mục chuẩn" Click="LoadStandard_Click"/><Button DockPanel.Dock="Right" Content="Tìm và tải lại" Click="Reload_Click" Padding="14,6"/><TextBox x:Name="SearchTerm" MinWidth="280" ToolTip="Tìm mã hoặc tên danh mục"/></DockPanel>
  <DataGrid x:Name="CatalogGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="CatalogGrid_SelectionChanged"><DataGrid.Columns>
   <DataGridTextColumn Header="Nhóm" Binding="{Binding Category}" Width="120"/><DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="120"/><DataGridTextColumn Header="Nhãn hiển thị" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="Phạm vi" Binding="{Binding Scope}" Width="130"/><DataGridCheckBoxColumn Header="Đang dùng" Binding="{Binding Active}" Width="90"/><DataGridTextColumn Header="Phiên bản" Binding="{Binding Version}" Width="80"/>
  </DataGrid.Columns></DataGrid>
  <WrapPanel Grid.Row="3" Margin="0,10,0,10"><Button Content="Trang trước" Click="Previous_Click" Padding="12,5"/><TextBlock x:Name="PageInfo" VerticalAlignment="Center" Margin="16,0"/><Button Content="Trang sau" Click="Next_Click" Padding="12,5"/></WrapPanel>
  <StackPanel Grid.Row="4"><TextBlock Text="THÊM / SỬA DANH MỤC (theo quyền được cấp)" FontWeight="Bold" Foreground="#102D59"/><WrapPanel Margin="0,8,0,8"><TextBox x:Name="CategoryCode" Width="105" Margin="0,0,7,0" ToolTip="Mã nhóm ví dụ: LOAI_NHA"/><TextBox x:Name="EntryCode" Width="105" Margin="0,0,7,0" ToolTip="Mã danh mục ví dụ: NHA_TRO"/><TextBox x:Name="EntryLabel" Width="240" Margin="0,0,7,0" ToolTip="Tên hiển thị"/><TextBox x:Name="EntryDetails" Width="260" Margin="0,0,7,0" ToolTip="Mô tả"/><CheckBox x:Name="EntryActive" Content="Đang sử dụng" IsChecked="True" VerticalAlignment="Center"/></WrapPanel><WrapPanel><Button x:Name="NewButton" Content="Tạo bản ghi mới" Click="New_Click" Padding="12,6" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="Lưu đúng mã / phiên bản" Click="Save_Click" Padding="12,6"/><TextBlock x:Name="ResultMessage" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel></StackPanel>
 </Grid>
</UserControl>
