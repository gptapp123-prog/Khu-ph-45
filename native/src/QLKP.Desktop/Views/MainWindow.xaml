<Window x:Class="QLKP.Desktop.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Quản lý Khu phố" Icon="pack://application:,,,/Assets/qlkp.ico" WindowState="Maximized" MinWidth="760" MinHeight="500" Background="{DynamicResource ThemeWorkspace}">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeHeader}" Padding="12,5">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image Source="pack://application:,,,/Assets/qlkp-icon.png" Width="32" Height="32" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock Grid.Column="1" Text="Quản lý Khu phố" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="CurrentUser" Foreground="#E2ECFC" FontSize="13" TextAlignment="Right" VerticalAlignment="Center" MaxWidth="235" TextTrimming="CharacterEllipsis"/>
     <Button x:Name="AccountButton" Click="Account_Click" Background="#102D59" BorderBrush="#577299" ToolTip="Quản trị tài khoản" Padding="8,5">
      <TextBlock x:Name="AccountLabel" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="#E2ECFC" FontSize="13" MaxWidth="235" TextTrimming="CharacterEllipsis"/>
     </Button>
     <Button x:Name="DisplayModeButton" Click="DisplayMode_Click" Padding="10,5" Margin="8,0,0,0"/>
     <Button x:Name="LogoutButton" Content="Đăng xuất" Click="Logout_Click" Margin="8,0,0,0" Padding="10,5"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Top" Background="#FAFBFB" BorderBrush="#D4DCE0" BorderThickness="0,0,0,1">
   <ListBox x:Name="Groups" AutomationProperties.Name="Nhóm nghiệp vụ" SelectionChanged="Groups_SelectionChanged"
    Margin="8,0" Padding="0,2" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavigationItem}"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0"/></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Border>
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D5E0ED" BorderThickness="0,0,0,1" Padding="8,4">
   <StackPanel>
    <WrapPanel>
     <Button x:Name="IntakeButton" Content="Nhập dữ liệu" Click="Intake_Click" Style="{StaticResource PrimaryAction}"/>
     <Button x:Name="MergeWorkspaceButton" Content="Hợp nhất kho" Click="MergeWorkspace_Click"/>
     <WrapPanel x:Name="ScopePanel" Visibility="Collapsed">
      <TextBlock Text="Khu phố" Margin="12,4,4,4" VerticalAlignment="Center"/>
      <ComboBox x:Name="AreaSelector" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="Area_Changed" Width="225"/>
     </WrapPanel>
    </WrapPanel>
    <TextBlock x:Name="WorkspaceState" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="570">
     <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
     </Style></TextBlock.Style>
    </TextBlock>
   </StackPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="#E6ECEE" Padding="8,2">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Kho dữ liệu mã hóa · Làm việc cục bộ" Foreground="#3A5360" TextWrapping="Wrap" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" x:Name="Status" TextAlignment="Right" VerticalAlignment="Center" Foreground="#526781" Margin="12,4,4,4"/>
   </Grid>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#FAFBFB" BorderBrush="#D4DCE0" BorderThickness="0,0,1,0"><DockPanel>
    <TextBlock x:Name="GroupTitle" Text="Chức năng" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" Foreground="#25394A" Margin="12,14,8,8" TextWrapping="Wrap"/>
    <ListBox x:Name="Features" SelectionChanged="Features_SelectionChanged" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#102D59" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel></Border>
   <Grid Grid.Column="1" Margin="10">
    <Border Style="{StaticResource WorkspacePanel}" IsHitTestVisible="False"/>
    <Border Padding="1">
    <ScrollViewer x:Name="ContentViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
     <ContentControl x:Name="FeatureContent" Width="{Binding ViewportWidth, ElementName=ContentViewport}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </ScrollViewer>
    </Border>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
