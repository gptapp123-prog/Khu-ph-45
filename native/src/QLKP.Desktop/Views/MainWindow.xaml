<Window x:Class="QLKP.Desktop.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Quản lý Khu phố" Icon="pack://application:,,,/Assets/qlkp.ico" WindowState="Maximized" MinWidth="960" MinHeight="560" Background="#F3F7FC">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#102D59" Padding="14,9">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image Source="pack://application:,,,/Assets/qlkp-icon.png" Width="42" Height="42" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock Grid.Column="1" Text="QUẢN LÝ KHU PHỐ" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="CurrentUser" Foreground="#E2ECFC" FontSize="13" TextAlignment="Right" VerticalAlignment="Center" MaxWidth="320" TextWrapping="Wrap"/>
     <Button x:Name="AccountButton" Click="Account_Click" Background="#102D59" BorderBrush="#577299" ToolTip="Quản trị tài khoản" Padding="8,5">
      <TextBlock x:Name="AccountLabel" Foreground="#E2ECFC" FontSize="13" MaxWidth="320" TextWrapping="Wrap"/>
     </Button>
     <Button x:Name="LogoutButton" Content="Đăng xuất" Click="Logout_Click" Margin="8,0,0,0" Padding="10,5"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="#E8EFF8" Padding="8,5">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Kho dữ liệu mã hóa · Làm việc cục bộ" Foreground="#964318" TextWrapping="Wrap" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" x:Name="Status" TextAlignment="Right" VerticalAlignment="Center" Foreground="#526781" Margin="12,4,4,4"/>
   </Grid>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#122D56"><DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="NHÓM NGHIỆP VỤ" FontWeight="Bold" Foreground="#DAE7FF" Margin="14,18"/>
    <ListBox x:Name="Groups" SelectionChanged="Groups_SelectionChanged" BorderThickness="0" Background="#122D56" Foreground="White" FontSize="14" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel></Border>
   <Border Grid.Column="1" Background="#E8F0FA" BorderBrush="#CDD9E8" BorderThickness="0,0,1,0"><DockPanel>
    <TextBlock x:Name="GroupTitle" Text="Chức năng" DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" Foreground="#102D59" Margin="14,18" TextWrapping="Wrap"/>
    <ListBox x:Name="Features" SelectionChanged="Features_SelectionChanged" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#102D59" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel></Border>
   <Border Grid.Column="2" Padding="10">
    <ScrollViewer x:Name="ContentViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
     <ContentControl x:Name="FeatureContent" Width="{Binding ViewportWidth, ElementName=ContentViewport}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </ScrollViewer>
   </Border>
  </Grid>
 </DockPanel>
</Window>
