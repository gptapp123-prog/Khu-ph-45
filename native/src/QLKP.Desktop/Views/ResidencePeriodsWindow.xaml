<Window x:Class="QLKP.Desktop.Views.ResidencePeriodsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Lịch sử địa chỉ cư trú" Width="920" Height="620"
 MinWidth="660" MinHeight="440" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="LỊCH SỬ ĐỊA CHỈ CƯ TRÚ" Foreground="#102D59" FontSize="23" FontWeight="Bold"/>
   <TextBlock x:Name="PersonTitle" Margin="0,4,0,12" TextWrapping="Wrap"/>
   <Border x:Name="Editor" BorderBrush="#D6E1EE" BorderThickness="1" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
    <StackPanel>
     <WrapPanel>
      <StackPanel Margin="0,0,10,0">
       <Label Target="{Binding ElementName=Kind}" Content="Loại cư trú"/>
       <ComboBox x:Name="Kind" Width="190" SelectedIndex="0">
        <ComboBoxItem Tag="thuong_tru" Content="Thường trú (khai báo)"/>
        <ComboBoxItem Tag="tam_tru" Content="Tạm trú (khai báo)"/>
       </ComboBox>
      </StackPanel>
      <StackPanel Margin="0,0,10,0">
       <Label Target="{Binding ElementName=ValidFrom}" Content="Từ ngày (dd-mm-yyyy)"/>
       <TextBox x:Name="ValidFrom" Width="150" MaxLength="10"/>
      </StackPanel>
      <StackPanel>
       <Label Target="{Binding ElementName=ValidUntil}" Content="Đến trước ngày (nếu có)"/>
       <TextBox x:Name="ValidUntil" Width="150" MaxLength="10"/>
      </StackPanel>
     </WrapPanel>
     <Label Target="{Binding ElementName=Address}" Content="Địa chỉ cư trú"/>
     <TextBox x:Name="Address" MaxLength="255"/>
     <Button Content="Ghi kỳ cư trú" Click="Save_Click" HorizontalAlignment="Left"/>
    </StackPanel>
   </Border>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
   <TextBlock x:Name="Message" TextWrapping="Wrap"/>
   <WrapPanel>
    <Button x:Name="Previous" Content="Trang trước" Click="Previous_Click"/>
    <Button x:Name="Next" Content="Trang sau" Click="Next_Click"/>
    <TextBlock x:Name="PageInfo" VerticalAlignment="Center" Margin="8,0"/>
    <Button Content="Đóng" IsCancel="True"/>
   </WrapPanel>
  </StackPanel>
  <DataGrid x:Name="Periods" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Loại" Binding="{Binding KindDisplay}" Width="155"/>
    <DataGridTextColumn Header="Từ ngày" Binding="{Binding ValidFromDisplay}" Width="100"/>
    <DataGridTextColumn Header="Đến trước ngày" Binding="{Binding ValidUntilDisplay}" Width="120"/>
    <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" Width="*" MinWidth="150"/>
    <DataGridTextColumn Header="Hiệu lực" Binding="{Binding StatusDisplay}" Width="105"/>
    <DataGridTextColumn Header="Thời điểm ghi" Binding="{Binding RecordedDisplay}" Width="150"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
