<UserControl x:Class="QLKP.Desktop.Views.OperationsDashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="White">
 <DockPanel Margin="14">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,9">
   <DockPanel LastChildFill="True">
    <Button x:Name="RefreshDashboard" DockPanel.Dock="Right" Content="Cập nhật số liệu" Click="Refresh_Click" Padding="10,4"/>
    <TextBlock Text="Bàn điều hành khu phố" FontSize="22" Foreground="#25394A" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
   </DockPanel>
   <TextBlock x:Name="Message" Foreground="#A34716" Margin="0,2"/>
  </StackPanel>
  <DataGrid x:Name="Summary" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
   <DataGrid.Columns><DataGridTextColumn Header="Mã" Binding="{Binding Feature}" Width="90"/>
    <DataGridTextColumn Header="Phân hệ" Binding="{Binding Label}" Width="*"/>
    <DataGridTextColumn Header="Tổng hồ sơ" Binding="{Binding Count}" Width="150"/>
    <DataGridTextColumn Header="Đang theo dõi" Binding="{Binding Open, TargetNullValue=—}" Width="200"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</UserControl>
