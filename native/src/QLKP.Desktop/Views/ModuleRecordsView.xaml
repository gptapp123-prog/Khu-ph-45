<UserControl x:Class="QLKP.Desktop.Views.ModuleRecordsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="White">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0">
   <TextBlock x:Name="FeatureTitle" FontWeight="Bold" FontSize="24" Foreground="#123663"/>
   <TextBlock x:Name="Guidance" TextWrapping="Wrap" Foreground="#576985" Margin="0,3,0,8"/>
   <DockPanel Margin="0,4,0,8"><Button Content="Làm mới" Click="Refresh_Click" DockPanel.Dock="Right" Padding="12,4"/>
    <TextBlock Text="Tìm mã hoặc tiêu đề: " VerticalAlignment="Center" DockPanel.Dock="Left"/>
    <TextBox x:Name="Search" MinWidth="230" Width="330" TextChanged="Search_Changed"/>
   </DockPanel>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2.5*"/></Grid.ColumnDefinitions>
   <DockPanel Grid.Column="0" Margin="0,0,10,0">
    <WrapPanel DockPanel.Dock="Bottom" Margin="2,8">
     <Button x:Name="Previous" Content="◀ Trước" Padding="12,6" Click="Previous_Click"/>
     <TextBlock x:Name="PageInfo" VerticalAlignment="Center" Margin="12,0"/>
     <Button x:Name="Next" Content="Sau ▶" Padding="12,6" Click="Next_Click"/>
    </WrapPanel>
    <DataGrid x:Name="Records" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Records_SelectionChanged"
     CanUserAddRows="False" SelectionMode="Single" EnableRowVirtualization="True">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="110"/>
      <DataGridTextColumn Header="Tên / trích yếu" Binding="{Binding Title}" Width="*"/>
      <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="150"/>
      <DataGridTextColumn Header="Ngày" Binding="{Binding DueDateDisplay}" Width="110"/>
      <DataGridTextColumn Header="Phiên bản" Binding="{Binding Version}" Width="75"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="8,0,0,0">
     <TextBlock Text="HỒ SƠ CHI TIẾT" FontWeight="Bold" Foreground="#123663" FontSize="17"/>
     <TextBlock Text="Mã định danh (không cho sửa khi cập nhật)" Margin="0,10,0,0"/>
     <TextBox x:Name="RecordCode"/>
     <TextBlock Text="Tiêu đề / mô tả ngắn" Margin="0,8,0,0"/>
     <TextBox x:Name="RecordTitle"/>
     <TextBlock Text="Trạng thái nghiệp vụ" Margin="0,8,0,0"/>
     <ComboBox x:Name="RecordStatus"/>
     <TextBlock Text="Thông tin chi tiết" Margin="0,8,0,0"/>
     <TextBox x:Name="RecordNotes" AcceptsReturn="True" Height="62" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
     <TextBlock Text="TRƯỜNG THEO CHUYÊN NGÀNH" FontWeight="Bold" Margin="0,12,0,0" Foreground="#123663"/>
     <StackPanel x:Name="TypedFields"/>
     <StackPanel x:Name="AssigneePicker" Margin="0,7,0,0">
      <TextBlock Text="Chọn người phụ trách công việc theo tài khoản" FontWeight="Bold"/>
      <Button Content="Tải tài khoản cùng khu phố" HorizontalAlignment="Left" Click="LoadAssignees_Click"/>
      <ListBox x:Name="AssigneeOptions" Height="80" DisplayMemberPath="Username" SelectionChanged="AssigneeOptions_SelectionChanged"/>
     </StackPanel>
     <TextBlock Text="LIÊN KẾT HỒ SƠ (CHỈ KHI CÓ QUAN HỆ THẬT)" FontWeight="Bold" Margin="0,12,0,0" Foreground="#123663" TextWrapping="Wrap"/>
     <ComboBox x:Name="RelatedFeature" Margin="0,4,0,0" SelectionChanged="RelatedFeature_Changed"/>
     <TextBox x:Name="RelatedId" Margin="0,5,0,0" IsReadOnly="True" ToolTip="Chỉ chọn ID từ kết quả tìm kiếm; không gõ liên kết thủ công"/>
     <WrapPanel Margin="0,6,0,0">
      <TextBox x:Name="RelatedKeyword" Width="190" TextChanged="RelatedKeyword_Changed" ToolTip="Tìm bằng mã hoặc tên, sau đó chọn đúng hồ sơ"/>
      <Button Content="Tìm liên kết" Margin="7,0,0,0" Click="Lookup_Click" Padding="9,3"/>
      <Button Content="Mở hồ sơ đích" Margin="7,0,0,0" Click="OpenRelated_Click" Padding="9,3"/>
     </WrapPanel>
     <ListBox x:Name="LinkResults" Height="80" DisplayMemberPath="Display" SelectionChanged="LinkResults_SelectionChanged"/>
     <WrapPanel Margin="0,3,0,8">
      <Button x:Name="LinkPrevious" Content="◀ Trước" Click="LinkPrevious_Click" Padding="6,2"/>
      <TextBlock x:Name="LinkPageInfo" VerticalAlignment="Center" Margin="10,0"/>
      <Button x:Name="LinkNext" Content="Sau ▶" Click="LinkNext_Click" Padding="6,2"/>
     </WrapPanel>
     <TextBlock Text="Mã liên kết phải đúng loại, đúng ID, đúng địa bàn và tài khoản phải có quyền đọc đích." FontSize="11" TextWrapping="Wrap" Foreground="#58708A"/>
     <TextBlock Text="CÁC LIÊN KẾT ĐÃ XÁC MINH (NHIỀU HỒ SƠ)" FontWeight="Bold" Margin="0,10,0,0" Foreground="#123663"/>
     <WrapPanel Margin="0,5,0,0">
      <ComboBox x:Name="RelationKind" Width="130"/>
      <Button x:Name="AddRelationButton" Content="Gắn liên kết" Click="AddRelation_Click" Margin="8,0,0,0" Padding="8,3"/>
      <Button Content="Mở liên kết" Click="OpenRelation_Click" Margin="8,0,0,0" Padding="8,3"/>
     </WrapPanel>
     <ListBox x:Name="Relations" Height="78" DisplayMemberPath="Display" Margin="0,5,0,0"/>

     <WrapPanel Margin="0,10,0,0">
      <Button x:Name="NewButton" Content="Hồ sơ mới" Margin="0,0,8,0" Padding="10,6" Click="New_Click"/>
      <Button x:Name="SaveButton" Content="Lưu hồ sơ" Padding="14,6" Click="Save_Click"/>
      <Button x:Name="CreateTaskButton" Content="Tạo nhiệm vụ A02" Padding="10,6" Margin="8,0,0,0" Click="CreateTask_Click"/>
      <Button x:Name="OpenTaskButton" Content="Mở nhiệm vụ để xử lý" Padding="10,6" Margin="8,0,0,0" Click="OpenTask_Click"/>
     </WrapPanel>
     <TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="#9E4A14" Margin="0,9"/>
     <TextBlock Text="LỊCH SỬ THAY ĐỔI" FontWeight="Bold" Margin="0,15,0,0" Foreground="#123663"/>
     <DataGrid x:Name="History" AutoGenerateColumns="False" IsReadOnly="True" Height="150" CanUserAddRows="False">
      <DataGrid.Columns><DataGridTextColumn Header="Thời điểm" Binding="{Binding OccurredDisplay}" Width="*"/><DataGridTextColumn Header="Trước" Binding="{Binding Before}" Width="100"/><DataGridTextColumn Header="Sau" Binding="{Binding After}" Width="100"/></DataGrid.Columns>
     </DataGrid>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
