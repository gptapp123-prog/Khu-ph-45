<UserControl x:Class="QLKP.Desktop.Views.OfflineCatalogTransferView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F8FBFF">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="18">
  <TextBlock Text="I06 · Chuyển danh mục sang Android" FontSize="23" FontWeight="Bold" Foreground="#102D59"/>
  <TextBlock Text="Chọn mật khẩu để bảo vệ tệp danh mục khi chuyển sang điện thoại." TextWrapping="Wrap" Foreground="#9A3A22" Margin="0,10,0,14"/>
  <TextBlock Text="Mật khẩu riêng để giải mã gói trên điện thoại (14–128 ký tự ASCII không dấu, không khoảng trắng)"/>
  <PasswordBox x:Name="PackagePassword" Margin="0,6,0,10" MaxLength="1024" Height="32"/>
  <Button Content="Xuất danh mục mã hóa (.qlkpsync)" Click="Export_Click" Padding="12,8" HorizontalAlignment="Left"/>
  <TextBlock x:Name="TransferStatus" Margin="0,14,0,0" TextWrapping="Wrap"/>
  <TextBlock Text="Trên QLKP Mobile, chọn tệp .qlkpsync đã xuất rồi nhập mật khẩu." Margin="0,20,0,0" TextWrapping="Wrap" Foreground="#445E7E"/>
 </StackPanel></ScrollViewer>
</UserControl>
