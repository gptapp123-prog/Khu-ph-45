<Window x:Class="QLKP.Desktop.Views.DataMergeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Hợp nhất dữ liệu khu phố" Width="850" Height="680" MinWidth="650" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#F4F7FC">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="HỢP NHẤT VÀO KHO ĐANG DÙNG" FontSize="22" FontWeight="Bold" Foreground="#102D59"/>
   <TextBlock Text="Chọn kho QLKP native (.db) đã đóng hoặc bản sao .qlkpbak. Chỉ nhập dữ liệu cùng mã khu phố. Tài khoản và quyền hiện có được giữ nguyên." TextWrapping="Wrap" Margin="0,8"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="Chọn kho nguồn…" Click="Choose_Click" MinHeight="36"/><TextBox x:Name="SourcePath" IsReadOnly="True" VerticalContentAlignment="Center" ToolTip="Đường dẫn kho nguồn được chọn"/></DockPanel>
   <TextBlock Text="Mật khẩu bản sao .qlkpbak (bỏ trống khi chọn .db trên máy này)" Margin="4,9,4,3" TextWrapping="Wrap"/>
   <PasswordBox x:Name="SourcePassword" Height="34"/>
   <Button x:Name="PreviewButton" Content="1. Đối chiếu dữ liệu" Click="Preview_Click" HorizontalAlignment="Left" Padding="16,8" Margin="4,10"/>
   <TextBlock x:Name="Result" Foreground="#9D421B" TextWrapping="Wrap" Margin="4,6"/>
  </StackPanel>
  <DataGrid x:Name="Summary" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="4,8">
   <DataGrid.Columns><DataGridTextColumn Header="Nhóm dữ liệu" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="Thêm mới" Binding="{Binding Added}" Width="120"/><DataGridTextColumn Header="Trùng hoàn toàn" Binding="{Binding Identical}" Width="140"/></DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="2"><TextBlock Text="Nếu có xung đột hoặc liên kết không hợp lệ, toàn bộ lô sẽ dừng. Hệ thống giữ bản phục hồi mã hóa trước khi áp dụng." TextWrapping="Wrap" Margin="4,6"/>
   <WrapPanel><Button x:Name="ApplyButton" Content="2. Áp dụng hợp nhất" IsEnabled="False" Click="Apply_Click" Padding="16,9"/><Button Content="Đóng" Click="Close_Click" Padding="16,9"/></WrapPanel>
  </StackPanel>
 </Grid>
</Window>
